#!/bin/sh
# Claude Code hook that reports the session's status to KinTerm using
# OSC 7501 (the Program Status Protocol). KinTerm shows it as a face on
# the tab and sends a notification when Claude finishes or needs you.
#
# Claude Code runs this for each hook event with the event as JSON on
# stdin. See install.sh for the hooks it is registered for.

# Only talk to terminals that understand OSC 7501. KinTerm still sets
# TERM_PROGRAM=ghostty, so programs that check for Ghostty's features keep
# working in it.
[ "$TERM_PROGRAM" = "ghostty" ] || exit 0

input=$(cat)

# Read a top-level string field from the hook's JSON input.
field() {
  if command -v jq >/dev/null 2>&1; then
    printf '%s' "$input" | jq -r --arg k "$1" '.[$k] // empty | if type == "string" then . else empty end' 2>/dev/null
  else
    printf '%s' "$input" | sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" | head -n 1
  fi
}

# Read a string field from the tool's input, e.g. the file being edited.
tool_field() {
  command -v jq >/dev/null 2>&1 || return 0
  printf '%s' "$input" | jq -r --arg k "$1" '.tool_input[$k] // empty | if type == "string" then . else empty end' 2>/dev/null
}

# Encode text for a title, msg or last value: one line, at most 180
# bytes, valid UTF-8 (iconv drops a character cut in half), then base64.
encode() {
  printf '%s' "$1" | tr '\n\r\t' '   ' | tr -d '\000-\037' | tr -s ' ' | head -c 180 |
    iconv -c -f UTF-8 -t UTF-8 2>/dev/null | base64 | tr -d '\n'
}

# How much of the context window the conversation uses, 0-100, from the
# token counts of the last reply in the transcript. Hooks aren't told
# this directly. The window size follows Claude Code's rules: 1M for
# Opus 4.7+, Sonnet 5+, Haiku 5.5+ and "[1m]" models, otherwise 200k.
context_percent() {
  command -v jq >/dev/null 2>&1 || return 0
  transcript=$(field transcript_path)
  [ -f "$transcript" ] || return 0
  tail -n 200 "$transcript" 2>/dev/null | jq -rs \
    --arg max "${CLAUDE_CODE_MAX_CONTEXT_TOKENS:-}" \
    --arg no1m "${CLAUDE_CODE_DISABLE_1M_CONTEXT:-}" '
    def window($model):
      ($model | capture("(?<family>opus|sonnet|haiku)-(?<major>[0-9]+)(-(?<minor>[0-9]{1,2})(?![0-9]))?")
        // {family: "", major: "0"}) as $m
      | ($m.major | tonumber) as $major | ($m.minor // "0" | tonumber) as $minor
      | if $max != "" then ($max | tonumber)
        elif $no1m == "1" then 200000
        elif ($model | contains("[1m]")) then 1000000
        elif $m.family == "opus" and ($major > 4 or ($major == 4 and $minor >= 7)) then 1000000
        elif $m.family == "sonnet" and $major >= 5 then 1000000
        elif $m.family == "haiku" and ($major > 5 or ($major == 5 and $minor >= 5)) then 1000000
        else 200000 end;
    [.[] | select(.type == "assistant" and (.isSidechain | not) and .message.usage != null)]
    | last // empty
    | ((.message.usage | (.input_tokens // 0) + (.cache_creation_input_tokens // 0)
        + (.cache_read_input_tokens // 0)) * 100 / window(.requestedModel // .message.model // ""))
    | if . > 100 then 100 else floor end
  ' 2>/dev/null
}

# How many shells Claude Code is running, such as a dev server it left
# running in the background: its Bash tool runs commands as children of
# Claude Code, sourcing a shell snapshot. Hooks run under Claude Code too,
# so count the children of this hook's nearest ancestors, skipping the
# ancestors. Only call it when no foreground command can be running.
count_shells() {
  ancestors=""
  pid=$PPID
  i=0
  while [ "${pid:-0}" -gt 1 ] && [ "$i" -lt 4 ]; do
    ancestors="$ancestors $pid"
    pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
    i=$((i + 1))
  done
  ps -A -o pid= -o ppid= -o command= 2>/dev/null | awk -v ancestors="$ancestors" '
    BEGIN { n = split(ancestors, a, " "); for (i = 1; i <= n; i++) up[a[i]] = 1 }
    ($2 in up) && !($1 in up) && /shell-snapshots\/snapshot-/ { shells++ }
    END { print shells + 0 }'
}

event=$(field hook_event_name)
cwd=$(field cwd)
kind=""
msg=""
last=""
shells=""

case "$event" in
  SessionStart)
    state=idle
    msg="Ready"
    ;;
  UserPromptSubmit)
    state=working
    msg=$(field prompt)
    shells=$(count_shells)
    ;;
  PreToolUse)
    state=working
    tool=$(field tool_name)
    detail=$(tool_field description)
    [ -n "$detail" ] || detail=$(tool_field file_path)
    [ -n "$detail" ] || detail=$(tool_field command)
    [ -n "$detail" ] || detail=$(tool_field pattern)
    if [ -n "$detail" ]; then msg="$tool: $detail"; else msg="$tool"; fi
    ;;
  PostToolUse)
    state=working
    msg="Thinking"
    # A command just went to the background. Other tools' events leave
    # the count alone: commands running in parallel would count too.
    if [ "$(field tool_name)" = Bash ] && command -v jq >/dev/null 2>&1 &&
      [ "$(printf '%s' "$input" | jq -r '.tool_input.run_in_background // false' 2>/dev/null)" = true ]; then
      shells=$(count_shells)
    fi
    ;;
  Notification)
    msg=$(field message)
    case "$msg" in
      # Claude also notifies when it has been idle for a while after
      # finishing. That isn't new, so keep showing "done".
      *"waiting for your input"*) exit 0 ;;
      *[Pp]ermission*) kind=permission ;;
      *) kind=question ;;
    esac
    state=blocked
    shells=$(count_shells)
    ;;
  Stop)
    state=done
    msg="Finished"
    last=$(field last_assistant_message)
    # Claude can finish its turn with shells still running in the
    # background, such as a dev server. KinTerm shows them as a badge.
    shells=$(count_shells)
    ;;
  StopFailure)
    # The turn ended on an API error: rate limit, overloaded, auth...
    state=error
    msg=$(field error_details)
    [ -n "$msg" ] || msg="Error: $(field error)"
    last=$(field last_assistant_message)
    shells=$(count_shells)
    ;;
  SessionEnd)
    state=clear
    ;;
  *)
    exit 0
    ;;
esac

# Which Claude account this is: the config folder's name, e.g.
# ".claude-work". KinTerm colors the ring around the face by account.
account=$(basename "${CLAUDE_CONFIG_DIR:-$HOME/.claude}" | tr -cd 'A-Za-z0-9_.+-' | cut -c1-32)

report="state=$state:app=claude-code"
[ -n "$account" ] && report="$report:account=$account"
[ -n "$kind" ] && report="$report:kind=$kind"
[ -n "$cwd" ] && report="$report:title=$(encode "$(basename "$cwd")")"
[ -n "$msg" ] && report="$report:msg=$(encode "$msg")"
[ -n "$last" ] && report="$report:last=$(encode "$last")"
[ -n "$shells" ] && report="$report:shells=$shells"
if [ "$state" != clear ]; then
  context=$(context_percent)
  [ -n "$context" ] && report="$report:context=$context"
fi

# The terminal to write to. Hooks don't get the terminal as stdout, and in
# an interactive session Claude Code starts them without a controlling
# terminal, so /dev/tty can't be opened. Then use the terminal of the
# nearest parent process that has one: Claude Code itself.
status_tty() {
  if [ -n "${GHOSTTY_STATUS_TTY:-}" ]; then
    echo "$GHOSTTY_STATUS_TTY"
    return
  fi
  if (: >/dev/tty) 2>/dev/null; then
    echo /dev/tty
    return
  fi
  pid=$PPID
  i=0
  while [ "${pid:-0}" -gt 1 ] && [ "$i" -lt 8 ]; do
    t=$(ps -o tty= -p "$pid" 2>/dev/null | tr -d ' ')
    case "$t" in
      "" | "?" | "??") ;;
      *)
        [ -w "/dev/$t" ] && echo "/dev/$t"
        return
        ;;
    esac
    pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
    i=$((i + 1))
  done
}

tty=$(status_tty)
[ -n "$tty" ] || exit 0

# Never fail the hook because of this.
printf '\033]7501;%s\033\\' "$report" 2>/dev/null >"$tty" || true
exit 0
